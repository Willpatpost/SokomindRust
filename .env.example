# Used by Docker Compose. For cargo/npm server, export DATABASE_URL in your shell.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://sokomind:local-development-only@127.0.0.1:5432/sokomind
BIND_ADDR=127.0.0.1:3000
SOLVE_CONCURRENCY=1
# Optional server settings, shown with their defaults. Export them for a local
# server; Compose uses only POSTGRES_PASSWORD from this file, so set them under
# the api service in compose.yaml instead.
# TRUSTED_PROXIES=
# SOLVE_RATE_PER_MINUTE=20
# PROGRESS_RETENTION_DAYS=0
