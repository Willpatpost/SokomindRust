# Copy this file to .env to change a setting: Docker Compose reads each one
# below that you uncomment. A setting left commented or empty takes the
# server's default, from README's Configuration table, which also lists the
# ranges. A local cargo server does not read .env; export the setting in your
# shell instead.

# Per API process: count these again for each replica. Each solve slot
# reserves up to 1024 MiB of search storage, so the 8-slot maximum reserves up
# to 8 GiB. The figures are MEMORY_MIB's cap and MAX_SOLVE_CONCURRENCY in
# crates/server/src/solve.rs and config.rs (checked by scripts/mirrors.test.mjs).
#SOLVE_CONCURRENCY=
#SOLVE_RATE_PER_MINUTE=

# Not a server setting: compose's network range, which the API trusts
# (compose.yaml explains). Commented or empty, it is 172.16.57.0/24; set one
# IPv4 CIDR only if that clashes with a network on your host.
#TRUSTED_SUBNET=
