# Docker Compose reads POSTGRES_PASSWORD and each server setting below that you
# uncomment, except DATABASE_URL. A setting left commented or empty takes the
# server's default, from README's Configuration table, which also lists the
# ranges.
POSTGRES_PASSWORD=local-development-only
# For a local cargo server, export this in your shell (the server does not
# read .env); compose ignores it.
#DATABASE_URL=postgres://sokomind:local-development-only@127.0.0.1:5432/sokomind

# Per API process: count these again for each replica. Each solve slot
# reserves up to 128 MiB of search storage, so the 8-slot maximum reserves up
# to 1 GiB. The figures are MEMORY_MIB's cap and MAX_SOLVE_CONCURRENCY in
# crates/server/src/solve.rs and config.rs (checked by scripts/mirrors.test.mjs).
#SOLVE_CONCURRENCY=
#SOLVE_RATE_PER_MINUTE=
#PROGRESS_CONCURRENCY=
# Best left unset, so it follows PROGRESS_CONCURRENCY (README explains).
#DB_POOL_SIZE=
# Public deployments should choose a retention policy; unset keeps routes forever.
#PROGRESS_RETENTION_DAYS=
# Each replica runs at most 20 batches per hourly sweep, so it deletes at most
# 20 times this many records an hour (README's Configuration table gives the
# figures). The batch count is RETENTION_MAX_BATCHES in
# crates/server/src/database.rs (checked by scripts/mirrors.test.mjs).
#PROGRESS_RETENTION_BATCH_SIZE=

# Not a server setting: compose's network range, which the API trusts
# (compose.yaml explains). Commented or empty, it is 172.16.57.0/24; set one
# IPv4 CIDR only if that clashes with a network on your host.
#TRUSTED_SUBNET=
