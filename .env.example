# Docker Compose reads POSTGRES_PASSWORD and the budget settings below. For a local
# cargo/npm server, export DATABASE_URL in your shell instead. Other settings:
# README's Configuration table.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://sokomind:local-development-only@127.0.0.1:5432/sokomind

# Per API process: count these again for each replica.
SOLVE_CONCURRENCY=1
PROGRESS_CONCURRENCY=4
DB_POOL_SIZE=5
# 0 keeps routes forever. Public deployments should choose a retention policy.
PROGRESS_RETENTION_DAYS=0
PROGRESS_RETENTION_BATCH_SIZE=500
