{
  "name": "sokomind-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "server": "node scripts/rust.mjs run -p sokomind-server --release",
    "check": "tsc -p web/tsconfig.json --noEmit",
    "check:rust": "node scripts/rust.mjs check --workspace",
    "test:core": "node scripts/rust.mjs test -p sokomind-core -p sokomind-search -p sokomind-server",
    "build": "npm run wasm && npm run build:web",
    "build:web": "tsc -p web && vite build web",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1"
  },
  "devDependencies": { "typescript": "~5.9.3", "vite": "8.3.1", "@types/node": "^24.0.0" }
}
