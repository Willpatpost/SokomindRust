{
  "name": "sokomind-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite web",
    "dev:web": "vite web",
    "server": "node scripts/rust.mjs run -p sokomind-server --release",
    "check": "npm run wasm && npm run check:web",
    "check:web": "tsc -p web && tsc -p web/tests",
    "check:scripts": "tsc -p scripts",
    "check:rust": "node scripts/rust.mjs check --workspace",
    "fmt:check": "node scripts/rust.mjs fmt --all -- --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "node scripts/rust.mjs clippy --workspace --all-targets -- -D warnings",
    "test:rust": "node scripts/rust.mjs test -p sokomind-core -p sokomind-search -p sokomind-server",
    "test:release": "node scripts/rust.mjs test --profile release-test -p sokomind-core -p sokomind-search",
    "test:web": "node --test web/tests/*.test.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "test:db": "node scripts/rust.mjs test -p sokomind-server live_postgres -- --ignored",
    "test:parity": "npm run wasm && node scripts/parity.mjs",
    "bench": "node scripts/benchmark.mjs",
    "bench:check": "node scripts/benchmark.mjs --check",
    "bench:update": "node scripts/benchmark.mjs --update",
    "bench:observe": "node scripts/benchmark.mjs --observe",
    "build": "npm run wasm && npm run build:web",
    "build:web": "npm run check:web && vite build web",
    "preview": "vite preview web --host 127.0.0.1",
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "vite": "8.3.1"
  }
}
